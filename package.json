{
  "name": "ghostprotocol",
  "version": "0.1.0",
  "private": true,
  "description": "A cryptographically enforced dead man's switch using ZK liveness proofs, Shamir secret sharing, IPFS, and Solidity time-lock vaults.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "circuit": "bash scripts/compile-circuit.sh",
    "proof:test": "node scripts/test-proof.js",
    "deploy": "hardhat run scripts/deploy.js --network sepolia",
    "verify:contracts": "node scripts/verify.js",
    "api": "node api/index.js",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "alchemy-sdk": "^3.1.2",
    "circomlib": "^2.0.5",
    "circomlibjs": "^0.1.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "resend": "^4.0.1",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "chai": "^4.5.0",
    "hardhat": "^2.22.19"
  }
}
